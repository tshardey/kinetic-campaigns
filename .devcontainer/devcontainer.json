{
  "name": "Kinetic Campaigns",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "if [ -f package.json ]; then npm install; fi",
  "forwardPorts": [5173, 54321, 54322],
  "remoteEnv": {
    "SUPABASE_PROJECT_REF": "${localEnv:SUPABASE_PROJECT_REF}",
    "VITE_SUPABASE_URL": "${localEnv:VITE_SUPABASE_URL}",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "${localEnv:VITE_SUPABASE_PUBLISHABLE_KEY}",
    "VITE_CAMPAIGN_ASSETS_USE_PUBLIC": "false"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
