# Supabase (required for auth, DB, storage, edge functions)
# Get these from your Supabase project: Settings → API → API Keys
# Use the publishable key (safe for browser). Do not use the secret key in the app.
# GitHub Pages: add the same two variables as repository secrets so the deploy workflow can inject them at build time.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional: pin a published campaign by id when multiple exist (omit to use the first published by id).
# VITE_CAMPAIGN_ID=omija
#
# Storage-only workflow (no public/campaign/omija/ in the repo): set to false and point VITE_SUPABASE_URL
# at local (`supabase start` → http://127.0.0.1:54321) or hosted project, then upload assets to the bucket.
# VITE_CAMPAIGN_ASSETS_USE_PUBLIC=false
#
# After `supabase db push` / reset (creates bucket `campaign-assets`), upload PNGs (e.g. from a local folder):
#   npm run upload:campaign-assets:local
# Remote (linked project): npm run upload:campaign-assets:remote
